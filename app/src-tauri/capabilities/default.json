{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Open UUOB (uuob://) so the user can allow the connection, find UUOB (here or on another device), update the app itself, fetch calendar links the user subscribes to (https only), and save a calendar as an .ics file where the user picks.",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "uuob://*"
        }
      ]
    },
    "uuob-update:default",
    "uuob-sdk:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    }
  ]
}
