<?xml version="1.0" encoding="utf-8"?>
<!-- The "Up next" widget (UpNext.kt): the timeline, drawn as one picture,
     light and dark (the phone shows the one for its mode). A tap opens Calendar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/timeline_day"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/up_next"
        android:scaleType="fitXY"
        android:visibility="@integer/widget_day" />

    <ImageView
        android:id="@+id/timeline_night"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/up_next"
        android:scaleType="fitXY"
        android:visibility="@integer/widget_night" />
</FrameLayout>
